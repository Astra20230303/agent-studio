{
  "name": "codex-desktop-replica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop": "electron .",
    "desktop:dev": "concurrently \"vite\" \"wait-on http://127.0.0.1:${VITE_PORT:-5317} && electron . --dev\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cron-parser": "5.4.0",
    "electron": "latest",
    "lucide-react": "latest",
    "playwright": "^1.63.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
